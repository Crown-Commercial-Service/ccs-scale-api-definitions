    private String getSelectedOptionValue(JsonNode requirement) {
        JsonNode options = requirement.path("nonOCDS").path("options");

        if (!options.isArray()) {
            return null;
        }

        String onlyOptionValue = null;
        int optionValueCount = 0;

        for (JsonNode option : options) {
            boolean selected = option.path("select").asBoolean(false) || option.path("selected").asBoolean(false);
            String value = option.path("value").asText(null);

            if (selected && value != null && !value.isBlank()) {
                return value.trim();
            }

            if (value != null && !value.isBlank()) {
                onlyOptionValue = value.trim();
                optionValueCount++;
            }
        }

        return optionValueCount == 1 ? onlyOptionValue : null;
    }

    private Set<String> getValidQuestionGroupNames(
            String projectId,
            String eventId,
            Integer stageNumber,
            String groupId,
            String accessToken) {

        QuestionGroupsResponseModel response = null;

        if ("2".equals(groupId)) {
            response = eventLogicClient.getAwardCriteriaQuestionGroups(projectId, eventId, stageNumber, accessToken);
        } else if ("1".equals(groupId)) {
            response = eventLogicClient.getConditionsOfParticipationQuestionGroups(projectId, eventId, stageNumber, accessToken);
        }

        if (response == null || response.questionGroups == null || response.questionGroups.isEmpty()) {
            return Set.of();
        }

        return response.questionGroups.stream()
                .filter(Objects::nonNull)
                .map(String::trim)
                .filter(groupName -> !groupName.isBlank())
                .collect(Collectors.toCollection(LinkedHashSet::new));
    }

